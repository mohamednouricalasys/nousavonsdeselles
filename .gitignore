# =============================================================
#  .gitignore — Landing page « Nous Avons Des Elles »
# =============================================================
#  Note : le dossier public/ (y compris public/images/) EST versionné.
#  C'est le livrable déployé sur WordPress. Les photos originales
#  (img/) ne le sont pas : voir ci-dessous.
# -------------------------------------------------------------

# --- Photos originales ----------------------------------------
# Le site n'utilise que les WebP de public/images/photos/. Des photos
# originales déposées ici ne doivent jamais partir sur le dépôt : elles
# sont lourdes, et celles des téléphones contiennent la position GPS.
img/

# --- Dépendances Node -----------------------------------------
node_modules/
.npm/
.pnpm-store/
.yarn/
.pnp.*

# --- Journaux et caches ---------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.cache/
.eslintcache
.stylelintcache
*.tsbuildinfo

# --- Variables d'environnement et secrets ---------------------
.env
.env.*
!.env.example
*.pem
*.key
# Identifiants de déploiement FTP/SFTP
sftp-config.json
.ftpconfig
.ftpquota
.vscode/sftp.json
deploy.config.*
!deploy.config.example.*

# --- Fichiers WordPress (ne jamais committer) -----------------
wp-config.php
wp-content/
wp-admin/
wp-includes/
*.sql
*.sql.gz
.htaccess.bak
.htaccess.backup
*.wpress

# --- Archives et exports de déploiement -----------------------
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z
dist/
build/
release/

# --- Systèmes d'exploitation ----------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
# Fichier fantôme créé par une redirection « > nul » mal interprétée
nul
# Linux
*~
.directory
.Trash-*

# --- Éditeurs / IDE -------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*.bak
*.tmp

# --- Outils locaux --------------------------------------------
.claude/settings.local.json
coverage/
.vercel/
.netlify/
